{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Default (Linux, macOS)",
      "description": "Default generator; libxml2, libcurl and zlib from the system",
      "binaryDir": "${sourceDir}/../build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "windows-x64",
      "displayName": "Windows x64 (Visual Studio, vcpkg)",
      "description": "64-bit build; libxml2, libcurl and zlib are installed by vcpkg from vcpkg.json (needs VCPKG_ROOT)",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/../build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-x86",
      "displayName": "Windows x86 (Visual Studio, vcpkg)",
      "description": "32-bit build; libxml2, libcurl and zlib are installed by vcpkg from vcpkg.json (needs VCPKG_ROOT)",
      "architecture": "Win32",
      "binaryDir": "${sourceDir}/../build/${presetName}",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x86-windows"
      }
    },
    {
      "name": "windows-x86-bundled",
      "displayName": "Windows x86 (Visual Studio, bundled libraries)",
      "description": "32-bit build with the old prebuilt libraries shipped in the repository; needs the Microsoft Visual C++ 2010 Redistributable (x86)",
      "architecture": "Win32",
      "binaryDir": "${sourceDir}/../build/${presetName}",
      "cacheVariables": {
        "LIBDASH_BUNDLED_DEPENDENCIES": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default"
    },
    {
      "name": "windows-x64",
      "configurePreset": "windows-x64",
      "configuration": "Release"
    },
    {
      "name": "windows-x86",
      "configurePreset": "windows-x86",
      "configuration": "Release"
    },
    {
      "name": "windows-x86-bundled",
      "configurePreset": "windows-x86-bundled",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "timeout": 300
      }
    },
    {
      "name": "windows-x64",
      "configurePreset": "windows-x64",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "timeout": 300
      }
    },
    {
      "name": "windows-x86",
      "configurePreset": "windows-x86",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "timeout": 300
      }
    },
    {
      "name": "windows-x86-bundled",
      "configurePreset": "windows-x86-bundled",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "timeout": 300
      }
    }
  ]
}
