<!-- libdash_mpd_test: List MPD with Linked Periods (ISO/IEC 23009-1, 6th edition, 5.3.2.6, 8.15, modelled on the List MPD example in Annex G) -->
<MPD xmlns="urn:mpeg:dash:schema:mpd:2011" profiles="urn:mpeg:dash:profile:list:2024" type="list"
     minBufferTime="PT1S" publishTime="2026-01-01T00:00:00Z">
  <BaseURL>http://cdn1.example.com/</BaseURL>
  <Period id="42" duration="PT15S">
    <ImportedMPD earliestResolutionTimeOffset="0">ad0.mpd</ImportedMPD>
    <EventStream schemeIdUri="urn:mpeg:dash:event:callback:2015" value="1">
      <Event presentationTime="0">http://example.com/beacon/ad0?time=0</Event>
    </EventStream>
    <ServiceDescription id="420">
      <PlaybackRestrictions skipAfter="PT5S"/>
    </ServiceDescription>
  </Period>
  <Period id="43" duration="PT15S">
    <ImportedMPD earliestResolutionTimeOffset="4.2">ad1.mpd</ImportedMPD>
  </Period>
  <Period id="44" duration="PT15S">
